// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Inventory {
  id             Int        @id @default(autoincrement())
  category       String?
  oldClubName    String?
  newClubName    String?
  poNumber       String?
  newPo          String?
  style          String
  colorCode      String?
  color          String
  materials      String?
  description    String?
  size           String
  allocation     Int?
  availableBalance Int?
  cartonNumber   Int?
  floorRow       String?
  palletNumber   String?
  rackNumber     String?
  lineNumber     String?
  side           String?
  otherLocation  String?
  remarks        String?
  stock          Int        @default(0)
  supplierId     Int?
  supplier       Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouseId    Int?
  warehouse      Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  orders         Order[]
}

model Supplier {
  id        Int         @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  createdAt DateTime    @default(now())
  inventory Inventory[]
}

model Warehouse {
  id        Int         @id @default(autoincrement())
  name      String
  location  String?
  createdAt DateTime    @default(now())
  inventory Inventory[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id           Int       @id @default(autoincrement())
  customer     String
  customerId   Int?
  customerLink Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  poNumber     String
  status       String
  quantity     Int       @default(1)
  inventoryId  Int?
  inventory    Inventory? @relation(fields: [inventoryId], references: [id])
  createdAt    DateTime  @default(now())
  expectedDate DateTime
}
